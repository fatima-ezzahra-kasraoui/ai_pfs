# Copier en .env (ignoré par Git). Ne jamais committer de vraies valeurs.
AI_SERVICE_KEY=change-me
AI_SERVICE_URL=http://ai-service:8000
POSTGRES_DB=agentshield
POSTGRES_USER=agentshield
POSTGRES_PASSWORD=change-me
VITE_API_BASE_URL=http://localhost:8080
# Guard A : nom du modèle Hugging Face (vide = règles seules, mode dégradé)
GUARD_A_MODEL=
GUARD_A_DEVICE=cpu
# Backend Spring Boot
SPRING_PROFILES_ACTIVE=dev
CORS_ALLOWED_ORIGINS=http://localhost:5173
