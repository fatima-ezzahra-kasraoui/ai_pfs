# Copier en .env (ignoré par Git). Ne jamais committer de vraies valeurs.
AI_SERVICE_KEY=change-me
AI_SERVICE_URL=http://ai-service:8000
POSTGRES_DB=agentshield
POSTGRES_USER=agentshield
POSTGRES_PASSWORD=change-me
VITE_API_BASE_URL=http://localhost:8080
# Guard A : nom du modèle Hugging Face (vide = règles seules, mode dégradé)
GUARD_A_MODEL=
GUARD_A_DEVICE=cpu
# Backend Spring Boot
SPRING_PROFILES_ACTIVE=dev
CORS_ALLOWED_ORIGINS=http://localhost:5173
# --- Service IA : sécurité et agent (AS-S1-008/009) ---
AI_ENV=dev                      # dev | test | recette | production ; recette/production : /docs désactivé par défaut et AI_STUB interdit
AI_EXPOSE_DOCS=                 # true/false ; vide = selon AI_ENV
AI_STUB=false                   # true : faux service IA contractuel (fixtures, en-tête X-Stub: true) ; refus de démarrer en recette/production
AI_MAX_BODY_BYTES=1048576
AGENT_MAX_STEPS=6
# --- LLM : "mock" (défaut, simulation sans réseau ni clé), "anthropic" ou "openai_compatible" ---
LLM_PROVIDER=mock
LLM_MODEL=                      # requis pour un fournisseur réel (identifiant exact du modèle retenu)
LLM_API_KEY=                    # jamais committé ; requis pour anthropic
LLM_BASE_URL=                   # requis pour openai_compatible (ex. http://localhost:11434/v1), optionnel pour anthropic
LLM_TIMEOUT_S=30
LLM_MAX_TOKENS=1024
LLM_MAX_RETRIES=1
